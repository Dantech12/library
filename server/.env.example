# Copy this file to server/.env (for running on your own computer),
# or enter these values in your host's dashboard (e.g. Render). Never share the secret key.

# Your website address, e.g. https://bookbridge.onrender.com (no slash at the end)
PUBLIC_BASE_URL=

# From Paystack Dashboard > Settings > API Keys & Webhooks.
# Use sk_test_... while testing, then sk_live_... to take real payments.
PAYSTACK_SECRET_KEY=

# Prices in pesewas (GH₵1 = 100 pesewas). 30000 = GH₵300.
BILLING_CURRENCY=GHS
PLAN_SCHOOL_AMOUNT=30000
PLAN_NETWORK_AMOUNT=120000
PLAN_SCHOOL_MAX_STUDENTS=1000
PLAN_NETWORK_MAX_STUDENTS=5000
TERM_MONTHS=4
TERM_DISCOUNT_PERCENT=10

# Shown on the website, receipts page and Terms / Privacy / Refund pages
BUSINESS_NAME=BookBridge
SUPPORT_EMAIL=
SUPPORT_PHONE=
# WhatsApp number with country code, digits only, e.g. 233241234567
SUPPORT_WHATSAPP=
BUSINESS_ADDRESS=
BUSINESS_COUNTRY=Ghana

# Where school accounts, student logins and the payment log are kept.
# Set MONGODB_URI to use a MongoDB database (needed on Render's free plan, whose disk is wiped on restart).
# Get it from MongoDB Atlas > your cluster > Connect > Drivers. Run "npm install" once to get the driver.
MONGODB_URI=
MONGODB_DB=bookbridge

# Without MONGODB_URI, they go in files in this folder (accounts.json and orders.jsonl). Default: data/
DATA_DIR=
